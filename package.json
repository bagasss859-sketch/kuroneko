  "repository": {
    "type": "git",
    "url": "https://github.com/bagasss859-sketch/kuroneko"
  },
  "bugs": {
    "url": "https://github.com/bagasss859-sketch/kuroneko/issues"
  },
  "homepage": "https://github.com/bagasss859-sketch/kuroneko#readme"
}
