# scrap-cat — Environment Configuration
# Copy this file to .env and fill in the secrets. Never commit .env.

# ── Manga source (WAJIB untuk source ini) ─────────────────────────────
# App secret + salt dari bundle JS situs manga API (lihat README
# "Credentials" untuk cara mendapatkannya). Tanpa ini API menolak request.
DOUJIN_APP_SECRET=
DOUJIN_SALT=
# Optional overrides
# DOUJIN_BASE_URL=https://doujin.desu.xxx
# DOUJIN_USER_AGENT=Mozilla/5.0 ...
# DOUJIN_TIMEOUT_MS=30000

# ── Source video posts (opsional overrides) ───────────────────────────
# NEKO_BASE_URL=https://nekopoi.care
# NEKO_TIMEOUT_MS=30000

# ── Source 2D streaming (opsional overrides) ──────────────────────────
# HENTAI_BASE_URL=https://hentai.tv
# HENTAI_TIMEOUT_MS=30000

# ── Source tube video API (opsional overrides) ────────────────────────
